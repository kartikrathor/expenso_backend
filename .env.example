# Expenso backend — copy to .env and fill values
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/expenso?retryWrites=true&w=majority
JWT_SECRET=99f2b85f26582166cfc6dd0e3a6f51bd9301696b2d2778eadd4a3ac7c8ec1fb2
JWT_EXPIRES_IN=7d

# Optional AI (unknown questions + pattern learning). Never commit real keys.
GEMINI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.1-8b-instant
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Daily token pool (per user). AI ≈ 20 msgs/day; rules burn slowly.
ASSISTANT_AI_ENABLED=true
ASSISTANT_DAILY_TOKENS=500
ASSISTANT_TOKEN_AI=25
ASSISTANT_TOKEN_RULES=1
ASSISTANT_TOKEN_CHIP=0

# —— In-app purchases (Google Play) ——
GOOGLE_PLAY_PACKAGE_NAME=com.kriovent.expenso
# Local file path; use a platform secret/file mount in production.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=secerets/google-play-service-account.json
# Alternative for hosts without secret-file mounts: full JSON on one line.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Dev only: skip store verification (NEVER enable in production)
# IAP_SKIP_VERIFY=true

ADMIN_EMAIL=admin@expenso.local
ADMIN_PASSWORD=change_me_admin_pass
# Set true only to reset intent patterns from code seed (wipes admin edits)
# SEED_OVERWRITE_INTENTS=false
