# Expenso backend — copy to .env and fill from Render Environment.
# Never commit real keys. JSON values must be one line.

# —— Required ——
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/expenso?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
PUBLIC_API_URL=https://expenso-backend-f61z.onrender.com

# —— Admin ——
ADMIN_EMAIL=admin@expenso.local
ADMIN_PASSWORD=change_me_admin_pass
# ADMIN_SYNC_PASSWORD=true

# —— Ask Expenso AI (at least one key) ——
GEMINI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.1-8b-instant
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
ASSISTANT_AI_ENABLED=true
ASSISTANT_DAILY_TOKENS=500
ASSISTANT_TOKEN_AI=25
ASSISTANT_TOKEN_RULES=1
ASSISTANT_TOKEN_CHIP=0

# —— Google Play IAP ——
GOOGLE_PLAY_PACKAGE_NAME=com.kriovent.expenso
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=secrets/google-play-service-account.json
# IAP_SKIP_VERIFY=true
# APPLE_IAP_SHARED_SECRET=

# —— FCM push (one of these) ——
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# —— Legal ——
LEGAL_CONTACT_EMAIL=kriovent.support@gmail.com

# Set true only to reset intent patterns from code seed (wipes admin edits)
# SEED_OVERWRITE_INTENTS=false
