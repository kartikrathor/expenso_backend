# Expenso backend — copy to .env and fill values
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/expenso?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional AI (unknown questions + pattern learning). Never commit real keys.
GEMINI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.1-8b-instant
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Daily token pool (per user). AI ≈ 20 msgs/day; rules burn slowly.
ASSISTANT_AI_ENABLED=true
ASSISTANT_DAILY_TOKENS=500
ASSISTANT_TOKEN_AI=25
ASSISTANT_TOKEN_RULES=1
ASSISTANT_TOKEN_CHIP=0

ASSISTANT_MISS_MAX=800
ASSISTANT_MISS_DAYS=30
ASSISTANT_MAINTAIN_HOURS=6
